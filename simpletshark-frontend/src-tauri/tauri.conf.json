{
  "productName": "simpletshark",
  "version": "1.0.2",
  "identifier": "com.xuanyuan.simpletshark",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../resources/tshark_win/tshark_server.exe",
      "../resources/tshark_win/tshark_server_helper.exe",
      "../resources/tshark_win/tshark_fields.db"
    ],
    "macOS": {
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "simpletshark",
        "width": 1024,
        "height": 640,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "center": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "main-capability",
          "description": "Main app capabilities",
          "windows": [
            "main"
          ],
          "permissions": [
            "core:default",
            "core:window:allow-create",
            "core:window:allow-maximize",
            "core:window:allow-unmaximize",
            "core:window:allow-is-maximized",
            "core:window:allow-minimize",
            "core:window:allow-close",
            "core:window:allow-start-dragging",
            "core:webview:allow-create-webview",
            "core:webview:allow-create-webview-window",
            "core:webview:allow-webview-position",
            "core:webview:allow-webview-size",
            "core:event:allow-listen",
            "core:event:allow-emit",
            "core:event:allow-emit-to",
            "dialog:default",
            "dialog:allow-open",
            "dialog:allow-save",
            "shell:default",
            "shell:allow-open",
            "process:default",
            "log:default",
            "log:allow-log"
          ]
        },
        {
          "identifier": "details-capability",
          "description": "Details window capabilities",
          "windows": [
            "details-*"
          ],
          "permissions": [
            "core:default",
            "core:window:allow-maximize",
            "core:window:allow-unmaximize",
            "core:window:allow-is-maximized",
            "core:window:allow-minimize",
            "core:window:allow-close",
            "core:window:allow-start-dragging",
            "log:default",
            "log:allow-log"
          ]
        }
      ]
    }
  }
}